# =============================================================================
# AIS Unified Environment Configuration
# Copy to `.env` for local development or engine builds.
# In EKS / Docker, pass these as container environment variables / Secrets.
# =============================================================================

# --- API Runtime (required to run the API server) ----------------------------
ENGINE_DB_HOST=
ENGINE_DB_PASS=
ENGINE_DB_USER=ais_engine
ENGINE_DB_NAME=ais_engine
ENGINE_DB_PORT=5432

# Optional Flask / SQLAlchemy tuning
DEBUG=false
SQLALCHEMY_ECHO=false
# SQLALCHEMY_POOL_SIZE=10
# SENTRY_DSN=

# --- Engine Build Server (only needed on the build host) ---------------------
LOCAL_ENGINE_DB_HOST=localhost
LOCAL_ENGINE_DB_USER=ais_engine
LOCAL_ENGINE_DB_PASS=
LOCAL_ENGINE_DB_NAME=ais_engine

# External data source connections (used by `ais engine build` and reports)
CITYGEO_DB_URL=
# Post-build report only (writes front-door address points to databridge_raw for NG911/Tripoli):
NG911_TRANSFORM_DB_URL=

# --- RDS Blue-Green Deployment & Swap ----------------------------------------
AWS_REGION=us-east-1
BLUE_RDS_IDENTIFIER=ais-engine-blue
GREEN_RDS_IDENTIFIER=ais-engine-green
DEV_RDS_IDENTIFIER=ais-engine-dev
BLUE_RDS_HOST=
GREEN_RDS_HOST=
DEV_RDS_HOST=

RDS_ENGINE_DB_PASS=
RDS_SUPER_ENGINE_DB_PASS=

# How the active RDS color (blue/green) is tracked & swapped for EKS:
# 1. SSM Parameter Store (stores "blue" or "green", and/or active DB host)
RDS_ACTIVE_COLOR_SSM_PARAM=/ais/prod/active_rds_color
RDS_ACTIVE_HOST_SSM_PARAM=/ais/prod/active_rds_host
# 2. Optional Route53 CNAME pointing to the active RDS endpoint (leave blank to skip)
RDS_ROUTE53_ZONE_ID=
RDS_ACTIVE_CNAME=
RDS_STAGING_CNAME=
